rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Kiểm tra tài khoản không bị Admin khóa (locked) hoặc cấm (banned)
    function isNotLocked() {
      return isAuthenticated() && (
        isAdmin() ||
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'locked' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned')))
      );
    }

    // 1. Collection Users (Quản lý người dùng)
    match /users/{userId} {
      allow read: if true; // Cho phép xem thông tin hồ sơ/chủ sách cả khi chưa đăng nhập

      // Khi đăng ký: Chỉ chính chủ được tạo, chặn leo quyền admin và tự đặt status khác 'active'
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
          (!('status' in request.resource.data) || request.resource.data.status == 'active'))
      );

      // Cập nhật tài khoản:
      // - Admin được toàn quyền cập nhật (bao gồm khóa/mở khóa)
      // - Chủ tài khoản được sửa hồ sơ, nhưng KHÔNG ĐƯỢC tự nâng role lên admin hoặc sửa status (tự mở khóa)
      // - CẤM tài khoản đã bị khóa (locked/banned) cập nhật hồ sơ hoặc đánh giá người khác
      // - Người dùng khác CHỈ ĐƯỢC cập nhật ratingAverage, ratingCount, reputationScore khi đánh giá (dùng hasOnly)
      allow update: if isAdmin() ||
        (isOwner(userId) && isNotLocked() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) ||
        (isNotLocked() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'reputationScore']));

      allow delete: if isAdmin();
    }

    // 2. Collection Books (Quản lý bài đăng sách)
    match /books/{bookId} {
      allow read: if true; // Cho phép duyệt danh sách sách

      // Tạo bài đăng: Phải đăng nhập, không bị khóa, và là chính chủ bài đăng hoặc Admin
      allow create: if (isAdmin() || isNotLocked()) && (
        isAdmin() ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      // Cập nhật bài đăng:
      // - CẤM tài khoản bị locked thao tác
      // - Chủ sách hoặc Admin được quyền sửa sách
      // - Người khác CHỈ ĐƯỢC cập nhật lượt xem (viewCount) và/hoặc lượt thích (favoriteCount)
      allow update: if isAdmin() || (
        isNotLocked() && (
          request.auth.uid == resource.data.ownerId || 
          request.auth.uid == resource.data.userId || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'favoriteCount'])
        )
      );

      // Xóa bài đăng: Chỉ chủ bài đăng không bị khóa hoặc Admin
      allow delete: if isAdmin() || (
        isNotLocked() && (
          request.auth.uid == resource.data.ownerId || 
          request.auth.uid == resource.data.userId
        )
      );
    }

    // 3. Collection Favorites (Yêu thích sách - FR09)
    match /favorites/{favoriteId} {
      // Đọc: Chỉ chính chủ mục yêu thích (không bị khóa) hoặc Admin mới được đọc
      allow read: if isAdmin() || (
        isNotLocked() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (resource == null && favoriteId.matches('^' + request.auth.uid + '_.*'))
        )
      );

      // Tạo: Chỉ chính chủ không bị khóa được thêm sách vào danh sách yêu thích
      allow create: if (isAdmin() || isNotLocked()) && request.resource.data.userId == request.auth.uid;

      // Sửa/Xóa: Chỉ chính chủ không bị khóa hoặc Admin
      allow update, delete: if isAdmin() || (
        isNotLocked() && resource != null && resource.data.userId == request.auth.uid
      );
    }

    // 4. Collection Requests (Quản lý yêu cầu nhận sách / trao đổi - FR10)
    match /requests/{requestId} {
      // Đọc: Chỉ người gửi yêu cầu (requester), chủ sách (owner) không bị khóa hoặc Admin mới được đọc
      allow read: if isAdmin() || (
        isNotLocked() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        )
      );

      // Tạo yêu cầu: Chỉ người gửi yêu cầu không bị khóa được tạo
      allow create: if (isAdmin() || isNotLocked()) && request.resource.data.requesterId == request.auth.uid;

      // Cập nhật hoặc Xóa: Chỉ người gửi yêu cầu, chủ sách không bị khóa hoặc Admin
      allow update, delete: if isAdmin() || (
        isNotLocked() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        )
      );
    }

    // 5. Collection Reviews (Đánh giá uy tín thành viên)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isNotLocked() && request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if isAdmin() || (isNotLocked() && request.auth.uid == resource.data.reviewerId);
    }

    // 6. Collection Comments (Bình luận sách - Cùng cấp với books, favorites, requests, users)
    // Khóa ngoại: bookId REF tới document trong collection books
    match /comments/{commentId} {
      // Đọc: Cho phép đọc bình luận công khai
      allow read: if true;

      // Tạo: Đăng nhập, không bị khóa, chính chủ userId, có trường khóa ngoại bookId hợp lệ trỏ tới sách tồn tại, nội dung hợp lệ
      allow create: if isNotLocked() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.bookId is string &&
        request.resource.data.bookId.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 1000;

      // Sửa: Chỉ tác giả bình luận không bị khóa hoặc Admin. Khóa ngoại bookId, userId, createdAt là bất biến (immutable)
      allow update: if (isAdmin() || (isNotLocked() && request.auth.uid == resource.data.userId)) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 1000 &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'bookId', 'createdAt']);

      // Xóa: Tác giả bình luận, Chủ của cuốn sách được comment (thông qua khóa ngoại bookId), hoặc Admin
      allow delete: if isAdmin() || (
        isNotLocked() && (
          request.auth.uid == resource.data.userId ||
          (
            resource.data.bookId is string &&
            exists(/databases/$(database)/documents/books/$(resource.data.bookId)) &&
            (
              request.auth.uid == get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.ownerId ||
              request.auth.uid == get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.userId
            )
          )
        )
      );
    }

    // ==========================================
    // 6. FEEDBACKS COLLECTION (Góp ý & Báo lỗi từ người dùng)
    // ==========================================
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isNotLocked() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000;
      allow update, delete: if isAdmin();
    }
  }
}
