rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Hàm tiện ích kiểm tra quyền & trạng thái tài khoản)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Kiểm tra tài khoản không bị Admin khóa (locked) hoặc cấm (banned)
    function isNotLocked() {
      return isAuthenticated() && (
        isAdmin() ||
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'locked' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned')))
      );
    }

    // =========================================================================
    // 1. Collection Users (Quản lý hồ sơ người dùng)
    // =========================================================================
    match /users/{userId} {
      allow read: if true; // Cho phép xem thông tin hồ sơ/chủ sách

      // Khi đăng ký: Chỉ chính chủ được tạo, chặn leo quyền admin và tự đặt status khác 'active'
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
          (!('status' in request.resource.data) || request.resource.data.status == 'active'))
      );

      // Cập nhật tài khoản:
      // - Admin được toàn quyền cập nhật (bao gồm khóa/mở khóa)
      // - Chủ tài khoản được sửa hồ sơ, nhưng KHÔNG ĐƯỢC tự nâng role lên admin hoặc sửa status
      // - Người dùng khác CHỈ ĐƯỢC cập nhật ratingAverage, ratingCount, reputationScore khi đánh giá
      allow update: if isAdmin() ||
        (isOwner(userId) && isNotLocked() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) ||
        (isNotLocked() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'reputationScore']));

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Collection Books (Quản lý bài đăng sách)
    // =========================================================================
    match /books/{bookId} {
      allow read: if true; // Cho phép duyệt danh sách sách

      // Tạo bài đăng: Phải đăng nhập, không bị khóa, và là chính chủ bài đăng hoặc Admin
      allow create: if (isAdmin() || isNotLocked()) && (
        isAdmin() ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      // Cập nhật bài đăng: Chủ sách, Admin hoặc người dùng tăng lượt viewCount/favoriteCount
      allow update: if isAdmin() || (
        isNotLocked() && (
          request.auth.uid == resource.data.ownerId || 
          request.auth.uid == resource.data.userId || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'favoriteCount'])
        )
      );

      // Xóa bài đăng: Chỉ chủ bài đăng không bị khóa hoặc Admin
      allow delete: if isAdmin() || (
        isNotLocked() && (
          request.auth.uid == resource.data.ownerId || 
          request.auth.uid == resource.data.userId
        )
      );
    }

    // =========================================================================
    // 3. Collection Favorites (Yêu thích sách)
    // =========================================================================
    match /favorites/{favoriteId} {
      allow read: if isAdmin() || (
        isNotLocked() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (resource == null && favoriteId.matches('^' + request.auth.uid + '_.*'))
        )
      );

      allow create: if (isAdmin() || isNotLocked()) && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin() || (
        isNotLocked() && resource != null && resource.data.userId == request.auth.uid
      );
    }

    // =========================================================================
    // 4. Collection Requests (Quản lý yêu cầu nhận sách / trao đổi)
    // =========================================================================
    match /requests/{requestId} {
      // Đọc: Chỉ người xin sách (requester), chủ sách (owner) không bị khóa hoặc Admin
      allow read: if isAdmin() || (
        isNotLocked() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        )
      );

      // Tạo yêu cầu: Chỉ người xin sách không bị khóa được tạo
      allow create: if (isAdmin() || isNotLocked()) && request.resource.data.requesterId == request.auth.uid;

      // Cập nhật hoặc Xóa: Chỉ người xin, chủ sách không bị khóa hoặc Admin
      allow update, delete: if isAdmin() || (
        isNotLocked() && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 5. Collection Reviews (Đánh giá uy tín thành viên)
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isNotLocked() && request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if isAdmin() || (isNotLocked() && request.auth.uid == resource.data.reviewerId);
    }

    // =========================================================================
    // 6. Collection Comments (Bình luận sách)
    // =========================================================================
    match /comments/{commentId} {
      allow read: if true;

      // Tạo: Đăng nhập, không bị khóa, chính chủ userId, nội dung hợp lệ <= 1000 ký tự
      allow create: if isNotLocked() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.bookId is string &&
        request.resource.data.bookId.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 1000;

      // Sửa: Chỉ tác giả bình luận không bị khóa hoặc Admin; khóa ngoại bookId, userId, createdAt là bất biến
      allow update: if (isAdmin() || (isNotLocked() && request.auth.uid == resource.data.userId)) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 1000 &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'bookId', 'createdAt']);

      // Xóa: Tác giả bình luận, Chủ cuốn sách được bình luận, hoặc Admin
      allow delete: if isAdmin() || (
        isNotLocked() && (
          request.auth.uid == resource.data.userId ||
          (
            resource.data.bookId is string &&
            exists(/databases/$(database)/documents/books/$(resource.data.bookId)) &&
            (
              request.auth.uid == get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.ownerId ||
              request.auth.uid == get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.userId
            )
          )
        )
      );
    }

    // 7. Collection Notifications (Quản lý thông báo thời gian thực)
    match /notifications/{notificationId} {
      // Đọc: Người nhận thông báo (resource.data.userId == request.auth.uid hoặc resource.data.recipientId == request.auth.uid) hoặc Admin
      allow read: if isAdmin() || (
        isNotLocked() && (
          resource.data.userId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        )
      );

      // Tạo: Người dùng đã xác thực (request.auth != null) và không bị khóa (isNotLocked())
      allow create: if isAuthenticated() && isNotLocked();

      // Cập nhật: Chủ sở hữu thông báo được cập nhật trường 'read' (đánh dấu đã đọc)
      allow update: if isAdmin() || (
        isNotLocked() && (
          resource.data.userId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        ) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'actionRequired'])
        )
      );

      // Xóa: Chủ sở hữu thông báo hoặc Admin
      allow delete: if isAdmin() || (
        isNotLocked() && (
          resource.data.userId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 8. Collection Feedbacks (Góp ý & Báo lỗi từ người dùng)
    // =========================================================================
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isNotLocked() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000;
      allow update, delete: if isAdmin();
    }
  }
}

