<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- DÁN NÚT YÊU THÍCH VÀO ĐÂY (Nằm ở góc trên cùng bên phải) -->
    <ImageView
        android:id="@+id/btn_favorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/cd_favorite"
        android:elevation="4dp"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_heart_outline" />

    <!-- PHẦN CUỘN NỘI DUNG SÁCH -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_comment_input"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Giả lập giao diện Chi tiết sách do Phúc phụ trách -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E5E7EB"
                android:gravity="center"
                android:text="[Khu vực ảnh bìa sách do Phúc thiết kế]" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Tên sách: Cây Cam Ngọt Của Tôi\n\n(Phần thông tin sách này Phúc sẽ làm. Dưới đây là phần bình luận của Vương.)"
                android:textColor="#000000"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="16dp"
                android:background="#D1D5DB" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hỏi đáp cộng đồng"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ĐOẠN 1 CỦA BẠN: KHUNG DANH SÁCH BÌNH LUẬN (Nằm trong ScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </ScrollView>

    <!-- ĐOẠN 2 CỦA BẠN: THANH NHẬP BÌNH LUẬN (Nằm ngoài ScrollView & ghim ở đáy) -->
    <LinearLayout
        android:id="@+id/layout_comment_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_comment_input"
            android:hint="@string/hint_comment"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_send_comment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_send_comment"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="#16A34A" />
    </LinearLayout>

</RelativeLayout>