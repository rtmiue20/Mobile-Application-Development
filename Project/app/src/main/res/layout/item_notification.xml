<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotificationItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Avatar / Icon Container with Unread Dot -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:clipToOutline="true"
                android:contentDescription="Notification Icon"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_notifications"
                app:tint="@color/primary" />

            <View
                android:id="@+id/viewUnreadDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_db_pill_red"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Notification Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Header Row: Status Tag & Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationStatusTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_db_pill_amber"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Chờ phản hồi"
                    android:textColor="@color/badge_pending_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvNotificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 phút trước"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Yêu cầu nhận sách mới"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Main Message -->
            <TextView
                android:id="@+id/tvNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:text="Nguyễn Văn A muốn nhận cuốn Sách hay của bạn."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <!-- Sub Message (Optional quote/note) -->
            <TextView
                android:id="@+id/tvNotificationSubMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_tag_grey"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="&quot;Chào bạn, mình rất muốn đọc cuốn này...&quot;"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- Call-to-action hint -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationActionHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chạm để mở trang yêu cầu"
                    android:textColor="@color/secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
