<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#FFF8E1"
            android:padding="10dp"
            android:src="@drawable/ic_star"
            app:tint="#FFB300" />

        <TextView
            android:id="@+id/tvRatingDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đánh giá trao đổi sách"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRatingDialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Bạn đã nhận được sách thành công! Hãy gửi đánh giá uy tín cho chủ sách nhé:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Star Rating Bar (5 clickable stars) -->
    <LinearLayout
        android:id="@+id/layoutStars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:contentDescription="1 sao"
            android:src="@drawable/ic_star"
            app:tint="#FFB300" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:contentDescription="2 sao"
            android:src="@drawable/ic_star"
            app:tint="#FFB300" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:contentDescription="3 sao"
            android:src="@drawable/ic_star"
            app:tint="#FFB300" />

        <ImageView
            android:id="@+id/ivStar4"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:contentDescription="4 sao"
            android:src="@drawable/ic_star"
            app:tint="#FFB300" />

        <ImageView
            android:id="@+id/ivStar5"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:contentDescription="5 sao"
            android:src="@drawable/ic_star"
            app:tint="#FFB300" />
    </LinearLayout>

    <!-- Dynamic feedback text -->
    <TextView
        android:id="@+id/tvRatingFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="5.0 ★ • Tuyệt vời &amp; Thân thiện!"
        android:textColor="#D97706"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Comment EditText -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary_dark_green"
        app:hintTextColor="@color/primary_dark_green">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRatingComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Chia sẻ cảm nghĩ về sách và người trao đổi (tùy chọn)..."
            android:inputType="textMultiLine"
            android:lines="3"
            android:maxLines="5"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelRating"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#F3F4F6"
            android:gravity="center"
            android:text="Để sau"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubmitRating"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_pill_active"
            android:gravity="center"
            android:text="Gửi đánh giá"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
